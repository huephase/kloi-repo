generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customers {
  id        String            @id @default(uuid())
  email     String?           @db.VarChar(100)
  phone     String?           @db.VarChar(20)
  createdAt DateTime          @default(now())
  firstName String?           @db.VarChar(50)
  lastName  String?           @db.VarChar(50)
  sessions  Session[]
  orders    kloiOrdersTable[]

  @@unique([phone, email], name: "unique_phone_email", map: "unique_phone_email")
  @@map("Customers")
}

model Leads {
  id        String            @id @default(uuid())
  email     String?           @db.VarChar(100)
  phone     String?           @db.VarChar(20)
  createdAt DateTime          @default(now())
  firstName String?           @db.VarChar(50)
  lastName  String?           @db.VarChar(50)
  orders    kloiOrdersTable[]

  @@map("Leads")
}

model Session {
  id        String     @id @default(uuid())
  userId    String?
  data      Json
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      Customers? @relation(fields: [userId], references: [id])
}

model Menus {
  id        String @id @default(uuid())
  name      String
  theme     String
  menuItems Json
}

model kloiOrdersTable {
  id            String      @id @default(uuid())
  orderNumber   Int         @unique @default(autoincrement())
  firstName     String      @db.VarChar(20)
  lastName      String      @db.VarChar(20)
  phone         String      @db.VarChar(20)
  email         String?     @db.VarChar(100)
  location      Json
  eventDetails  Json
  eventSetup    Json?
  status        OrderStatus @default(PENDING)
  totalAmount   Decimal?    @db.Decimal(10, 2)
  
  // 🟡🟡🟡 - [2025-01-XX] Payment tracking fields for payment integration
  paymentProvider String?   @db.VarChar(50)  // Provider identifier: 'stripe', 'paypal', etc.
  paymentIntentId String?   @db.VarChar(255) // Provider's payment intent/charge ID
  paymentStatus   String?   @db.VarChar(50)  // Status: 'pending', 'succeeded', 'failed', 'refunded'
  paymentMethodId String?   @db.VarChar(255) // Saved payment method ID (optional, for future use)
  paidAt          DateTime? @db.Timestamptz(6) // Timestamp when payment was completed
  
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(6)
  userId        String?
  leadId        String?
  sessionId     String?
  eventDateTime Json?
  user          Customers?  @relation(fields: [userId], references: [id])
  lead          Leads?      @relation(fields: [leadId], references: [id])

  @@map("kloiOrdersTable")
}

model deliveryLocations {
  id            BigInt   @id @default(autoincrement())
  district      String   @unique
  sublocalities Json     @default("[]")
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  country       String?
  city          String?

  @@index([sublocalities], map: "delivery_locations_sublocalities_gin", type: Gin)
  @@map("deliveryLocations")
}

model TaxesFees {
  id              String    @id @default(uuid())
  code            String    @unique @db.VarChar(50)
  name            String    @db.VarChar(100)
  type            String    @db.VarChar(20)
  category        String    @db.VarChar(50)
  country_code    String    @db.VarChar(10)
  applies_to      String    @db.VarChar(50)
  calculation_type String   @db.VarChar(20)
  rate_value      Decimal   @db.Decimal(10, 2)
  currency        String    @db.VarChar(10)
  active          Boolean   @default(true)
  startDate       DateTime? @db.Timestamptz(3)
  endDate         DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@index([country_code], map: "taxesFees_country_code_idx")
  @@index([active], map: "taxesFees_active_idx")
  @@index([startDate, endDate], map: "taxesFees_dates_idx")
  @@map("taxesFees")
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  CANCELLED
  COMPLETED
}
