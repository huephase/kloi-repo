{{!-- 🟡🟡🟡 - [ADMIN MENU EDITOR] Menu editor page for editing menu JSON --}}

{{! 🟡🟡🟡 - [STYLESHEET] Admin page specific styles }}
<link rel="stylesheet" href="/public/global/css/admin.css">

<div class="admin-container">
  <header class="admin-header">
    <div class="admin-header-content">
      <h1>Menu Editor</h1>
    </div>
    <form method="POST" action="/admin/logout" class="admin-logout-form">
      {{#if csrfToken}}
      <input type="hidden" name="_csrf" value="{{csrfToken}}" />
      {{/if}}
      <button type="submit" class="admin-logout-button">Logout</button>
    </form>
  </header>

  <div class="admin-menu-editor-wrapper">
    <div class="admin-menu-info">
      {{#if menu}}
        <p class="admin-menu-name">Editing: <strong>{{menu.name}}</strong></p>
        <p class="admin-menu-id">Menu ID: <code>{{menu.id}}</code></p>
      {{else}}
        <p class="admin-menu-name">No menu found for this theme. Create a new menu below.</p>
      {{/if}}
    </div>

    {{! 🟡🟡🟡 - [MENU DATA] Store menu data in data attribute for JavaScript access }}
    {{! 2026-01-12T19:10:00Z 🟡🟡🟡 - [CSRF] Store CSRF token in data attribute for AJAX requests }}
    <div id="menu-editor-container" 
         class="admin-menu-editor-container"
         data-menu-items="{{#if menu}}{{json menu.menuItems}}{{else}}null{{/if}}"
         data-menu-name="{{#if menu}}{{menu.name}}{{else}}null{{/if}}"
         data-theme="{{theme}}"
         {{#if csrfToken}}data-csrf-token="{{csrfToken}}"{{/if}}>
      <div id="sections-list" class="admin-sections-list"></div>
    </div>

    <div class="admin-menu-actions">
      <button id="preview-menu-button" class="admin-preview-button">
        Preview Menu
      </button>
      <button id="save-menu-button" class="admin-save-button">
        Save Menu
      </button>
      <button id="reset-menu-button" class="admin-reset-button">
        Reset to Original
      </button>
    </div>

    <div id="admin-message" class="admin-message" style="display: none;"></div>
  </div>
</div>

{{! 🟡🟡🟡 - [SORTABLEJS] SortableJS library for drag-and-drop functionality }}
<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
{{! 🟡🟡🟡 - [ADMIN JS] Admin menu editor JavaScript }}
<script src="/public/global/js/admin-menu-editor.js"></script>

