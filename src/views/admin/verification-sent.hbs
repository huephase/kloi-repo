{{!-- 2025-12-29T00:00:00Z 🟡🟡🟡 - [ADMIN VERIFICATION SENT] Verification email sent confirmation page --}}

{{! 🟡🟡🟡 - [STYLESHEET] Admin page specific styles }}
<link rel="stylesheet" href="/public/global/css/admin.css">

<div class="admin-login-container">
  <div class="admin-login-card">
    <header class="admin-login-header" style="background-color: #2196F3;">
      <h1>Check Your Email</h1>
      <p class="admin-theme-badge">Theme: <strong>{{theme}}</strong></p>
    </header>

    <div class="admin-success-message" style="padding: 20px; text-align: center;">
      <div style="font-size: 48px; margin-bottom: 20px;">📧</div>
      <h2>Verification Email Sent</h2>
      {{#if email}}
        <p>We've sent a verification email to <strong>{{email}}</strong>.</p>
      {{else}}
        <p>We've sent a verification email to your email address.</p>
      {{/if}}
      <p style="margin-top: 20px;">Please check your inbox and click the verification link to verify your email address.</p>
      <p style="margin-top: 10px; font-size: 14px;">The verification link will expire in 7 days.</p>
      
      <div style="margin-top: 30px; padding: 15px; background-color: #fff3cd; border-left: 4px solid #ffc107; border-radius: 4px;">
        <p style="margin: 0;"><strong>Didn't receive the email?</strong></p>
        <p style="margin: 5px 0 0 0; font-size: 14px;">Check your spam folder or <a href="#" id="resend-link" style="color: #2196F3;">resend verification email</a>.</p>
      </div>
    </div>

    <footer class="admin-login-footer">
      <p><a href="/admin/login?theme={{theme}}">Return to login</a></p>
    </footer>
  </div>
</div>

<script>
  // Resend verification email functionality
  document.getElementById('resend-link')?.addEventListener('click', async function(e) {
    e.preventDefault();
    const email = '{{email}}';
    
    if (!email) {
      alert('Email address not found. Please contact support.');
      return;
    }

    try {
      const response = await fetch('/admin/resend-verification', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ email })
      });

      const data = await response.json();
      
      if (data.success) {
        alert('Verification email sent successfully! Please check your inbox.');
      } else {
        alert(data.message || 'Failed to resend verification email. Please try again later.');
      }
    } catch (error) {
      alert('An error occurred. Please try again later.');
    }
  });
</script>

