    // 🟡🟡🟡 - [INITIALIZATION] Initialize all functionality
    // 🟡🟡🟡 - [FORM PRE-FILL] Pre-fill form inputs from session data
    function prefillFormFromSession() {
        console.log('🟡🟡🟡 - [EVENT SETUP JS] Pre-filling form from session data');
        
        const serverDataDiv = document.getElementById('serverData');
        if (!serverDataDiv) {
            console.log('🟡🟡🟡 - [EVENT SETUP JS] Server data div not found, skipping pre-fill');
            return;
        }
        
        const eventSetupJsonAttr = serverDataDiv.getAttribute('data-event-setup');
        if (!eventSetupJsonAttr || eventSetupJsonAttr === 'null') {
            console.log('🟡🟡🟡 - [EVENT SETUP JS] No eventSetup data in session, skipping pre-fill');
            return;
        }
        
        try {
            const eventSetup = JSON.parse(eventSetupJsonAttr);
            console.log('🟡🟡🟡 - [EVENT SETUP JS] EventSetup data parsed:', eventSetup);
            
            // 🟡🟡🟡 - [RADIO SELECTIONS] Pre-fill radio buttons
            if (eventSetup.radioSelections && typeof eventSetup.radioSelections === 'object') {
                Object.entries(eventSetup.radioSelections).forEach(([groupId, optionKey]) => {
                    const radioInput = document.querySelector(`input[type="radio"][name="${groupId}"][value="${optionKey}"]`);
                    if (radioInput) {
                        radioInput.checked = true;
                        // 🟡🟡🟡 - [RADIO EXPANSION] Expand the selected radio option
                        const radioOption = radioInput.closest('.radio-option');
                        if (radioOption) {
                            radioOption.classList.remove('contracted');
                            radioOption.classList.add('expanded');
                            // 🟡🟡🟡 - [VIEW DETAILS BUTTON] Show view details button if it exists
                            const viewDetailsBtn = radioOption.querySelector('.view-details-btn');
                            if (viewDetailsBtn) {
                                viewDetailsBtn.style.display = 'inline-block';
                            }
                        }
                        // 🟡🟡🟡 - [RADIO CONTRACTION] Contract other options in the same group
                        const radioGroup = radioInput.closest('.radio-group');
                        if (radioGroup) {
                            const otherOptions = radioGroup.querySelectorAll('.radio-option');
                            otherOptions.forEach(otherOption => {
                                if (otherOption !== radioOption) {
                                    otherOption.classList.remove('expanded');
                                    otherOption.classList.add('contracted');
                                    const otherBtn = otherOption.querySelector('.view-details-btn');
                                    if (otherBtn) {
                                        otherBtn.style.display = 'none';
                                    }
                                }
                            });
                        }
                        console.log('✅✅✅ - [EVENT SETUP JS] Pre-filled radio:', groupId, '->', optionKey);
                    }
                });
            }
            
            // 🟡🟡🟡 - [CHECKBOX SELECTIONS] Pre-fill checkboxes
            if (eventSetup.checkboxSelections && typeof eventSetup.checkboxSelections === 'object') {
                Object.entries(eventSetup.checkboxSelections).forEach(([optionKey, value]) => {
                    const checkboxInput = document.querySelector(`input[type="checkbox"][name="${optionKey}"][value="${optionKey}"]`);
                    if (checkboxInput) {
                        checkboxInput.checked = true;
                        console.log('✅✅✅ - [EVENT SETUP JS] Pre-filled checkbox:', optionKey);
                    }
                });
            }
            
            // 🟡🟡🟡 - [PRODUCT QUANTITIES] Pre-fill quantity inputs (including guest-count)
            if (eventSetup.productQuantities && typeof eventSetup.productQuantities === 'object') {
                Object.entries(eventSetup.productQuantities).forEach(([productKey, quantity]) => {
                    const quantityInput = document.querySelector(`input.quantity-input[name="${productKey}"]`);
                    if (quantityInput && typeof quantity === 'number' && quantity >= 0) {
                        quantityInput.value = quantity.toString();
                        // 🟡🟡🟡 - [GUEST COUNT] Show guest counter container if guest count is set
                        if (productKey === 'guest-count' && quantity > 0) {
                            const guestCounterContainer = document.getElementById('guest-counter-container');
                            if (guestCounterContainer) {
                                guestCounterContainer.style.display = '';
                            }
                        }
                        console.log('✅✅✅ - [EVENT SETUP JS] Pre-filled quantity:', productKey, '->', quantity);
                    }
                });
            }
            
            console.log('✅✅✅ - [EVENT SETUP JS] Form pre-filled from session data');
            
            // 🟡🟡🟡 - [CALCULATOR UPDATE] Update calculator with pre-filled values if calculator is already initialized
            // 2025-12-20T00:00:00Z 🟡🟡🟡 - [DRY REFACTOR] Using calculator-state module when eventSetup data is available
            if (calc) {
                console.log('🟡🟡🟡 - [EVENT SETUP JS] Updating calculator with pre-filled form values');
                
                // 🟡🟡🟡 - [CALCULATOR STATE] Try to restore from eventSetup data first, otherwise read from form
                const eventSetupJsonAttr = serverDataDiv.getAttribute('data-event-setup');
                if (eventSetupJsonAttr && eventSetupJsonAttr !== 'null' && window.KloiCalculatorState && window.KloiCalculatorState.restoreCalculatorState) {
                    try {
                        const eventSetup = JSON.parse(eventSetupJsonAttr);
                        console.log('🟡🟡🟡 - [EVENT SETUP JS] Restoring calculator state from eventSetup data');
                        window.KloiCalculatorState.restoreCalculatorState(calc, eventSetup, { skipGuestCount: false, skipProducts: false });
                        calc.recalc();
                        console.log('✅✅✅ - [EVENT SETUP JS] Calculator state restored from eventSetup data');
                    } catch (e) {
                        console.error('❗❗❗ - [EVENT SETUP JS] Error restoring calculator state from eventSetup:', e);
                        // Fallback to reading from form
                        updateCalculatorFromForm();
                    }
                } else {
                    // 🟡🟡🟡 - [FORM VALUES] Read from pre-filled form inputs (fallback)
                    updateCalculatorFromForm();
                }
            }
            
            function updateCalculatorFromForm() {
                // 🟡🟡🟡 - [GUEST COUNT] Update guest count in calculator
                const guestInput = document.querySelector('#guest-counter-container .quantity-input[name="guest-count"]');
                if (guestInput) {
                    const guestCountValue = parseInt(guestInput.value) || 0;
                    if (guestCountValue > 0) {
                        calc.setGuestCount(guestCountValue);
                        console.log('✅✅✅ - [EVENT SETUP JS] Calculator guest count updated:', guestCountValue);
                    }
                }
                
                // 🟡🟡🟡 - [RADIO SELECTIONS] Update radio selections in calculator
                const selectedRadios = document.querySelectorAll('input[type="radio"]:checked');
                selectedRadios.forEach(r => {
                    calc.setRadio(r.name, r.value);
                    console.log('🟡🟡🟡 - [EVENT SETUP JS] Calculator radio updated:', r.name, '->', r.value);
                });
                
                // 🟡🟡🟡 - [CHECKBOX SELECTIONS] Update checkbox selections in calculator
                const selectedCheckboxes = document.querySelectorAll('input[type="checkbox"]:checked');
                selectedCheckboxes.forEach(cb => {
                    calc.setCheckbox(cb.value, true);
                    console.log('🟡🟡🟡 - [EVENT SETUP JS] Calculator checkbox updated:', cb.value);
                });
                
                // 🟡🟡🟡 - [PRODUCT QUANTITIES] Update product quantities in calculator
                const productInputs = document.querySelectorAll('.product-group .quantity-input, .addon-group .quantity-input');
                productInputs.forEach(pi => {
                    const qty = parseInt(pi.value) || 0;
                    if (qty > 0 || pi.name === 'guest-count') {
                        calc.setProductQty(pi.name, qty);
                        console.log('🟡🟡🟡 - [EVENT SETUP JS] Calculator product quantity updated:', pi.name, '->', qty);
                    }
                });
                
                // 🟡🟡🟡 - [CALCULATOR RECALC] Recalculate calculator totals
                calc.recalc();
                console.log('✅✅✅ - [EVENT SETUP JS] Calculator updated with pre-filled form values');
            }
        } catch (error) {
            console.error('❗❗❗ - [EVENT SETUP JS] Error pre-filling form from session:', error);
        }
    }
    
    function initialize() {
        console.log('🟡🟡🟡 - [EVENT SETUP JS] Initializing event setup page');
        
        // 🟡🟡🟡 - [FORM PRE-FILL] Pre-fill form from session data BEFORE other initialization
        prefillFormFromSession();
        
        initializePopupData();
        initializeQuantityControls();
        initializeRadioContraction();
        initializeFormSubmission();
        initializeEventListeners();
        updateOrderSummary();
        positionGuestCounter();

        // 🟡🟡🟡 - [AUTO-SAVE] Enable continuous auto-save to protect against back button/page refresh
        if (window.KloiWizardProgress) {
            window.KloiWizardProgress.enableAutoSaveOnChange(
                form,
                'event',
                function () { return window.KloiWizardProgress.collectEventSetupFormData(form); },
                { debounceMs: 700, inputsSelector: 'input, select, textarea' }
            );
        }

        // 🟡🟡🟡 - [KLOI CALC] Seed initial selections into calculator
        if (calc) {
            // Guest count
            const guestInput = document.querySelector('#guest-counter-container .quantity-input[name="guest-count"]');
            if (guestInput) {
                calc.setGuestCount(parseInt(guestInput.value) || 0);
            }
            // Radios
            const selectedRadios = document.querySelectorAll('input[type="radio"]:checked');
            selectedRadios.forEach(r => calc.setRadio(r.name, r.value));
            // Checkboxes
            const selectedCheckboxes = document.querySelectorAll('input[type="checkbox"]:checked');
            selectedCheckboxes.forEach(cb => calc.setCheckbox(cb.value, true));
            // Products (including addon items)
            // 2025-11-28T00:00:00Z 🟡🟡🟡 - [ADDON ITEMS] Include both regular product-group inputs and addon-group inputs
            const productInputs = document.querySelectorAll('.product-group .quantity-input, .addon-group .quantity-input');
            productInputs.forEach(pi => calc.setProductQty(pi.name, parseInt(pi.value) || 0));
            console.log('🟡🟡🟡 - [EVENT SETUP JS] Initialized product quantities:', productInputs.length, 'inputs');
            calc.recalc();
            // 🟡🟡🟡 - [MINIMUM ORDER VISIBILITY] Update minimum order visibility after initial calculator setup
            updateMinimumOrderVisibility();
        }
        
        // 🟡🟡🟡 - [ADDON MAX VALUES] Initialize addon max values based on initial guest count
        updateAddonMaxValues();
        
        console.log('✅✅✅ - [EVENT SETUP JS] Event setup page initialized');
    }
    
    // 🟡🟡🟡 - [START] Start initialization
    initialize();
});
</script>
