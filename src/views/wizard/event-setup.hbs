{{! src/views/wizard/event-setup.hbs }}
{{! Event setup view with dynamic menu form }}

{{! 🟡🟡🟡 - [STYLESHEET] Event setup specific styles }}
<link rel="stylesheet" href="/public/global/css/event__setup.css">

<div class="event-setup-container">
    <h3>Customize Your Menu</h3>
    
    {{#if menuError}}
        <div class="error-message">
            <p>⚠️⚠️⚠️ - [EVENT SETUP] {{menuError}}</p>
            <p>Please try refreshing the page or contact support.</p>
        </div>
    {{/if}}

    {{#unless hasMenuData}}
        <div class="loading-message">
            <p>🟡🟡🟡 - [EVENT SETUP] Loading menu options...</p>
        </div>
    {{/unless}}

    {{#if hasMenuData}}
        <form id="eventSetupForm" class="menu-form">

            {{! 🟡🟡🟡 - [MENU SECTIONS] Render each menu section in order }}
            {{#each menuSections}}
                <div class="menu-section {{className}}" data-section-id="{{id}}" data-order="{{order}}">
                    {{! 🟡🟡🟡 - [SECTION HEADERS] Handle h1, h2, p elements }}
                    {{#if (eq htmlType "h1")}}
                        <h1 class="section-title">{{content}}</h1>
                    {{else if (eq htmlType "h2")}}
                        <h2 class="section-title">{{content}}</h2>
                        {{! 🟡🟡🟡 - [ADDON ITEMS] Check if this is "Add Ons" section with nested addon-items }}
                        {{#if (eq content "Add Ons")}}
                            {{#if (get this "addon-items")}}
                                <div class="product-group addon-group" data-group-name="{{id}}" data-is-addon="true">
                                    {{#each (get this "addon-items")}}
                                        <div class="product-item addon-item" data-product-id="{{@key}}" data-product-label="{{label}}">
                                            <div class="product-info">
                                                <label class="product-label">
                                                    <strong>{{label}}</strong>
                                                    {{#if price}}
                                                        <span class="price">AED {{price}}
                                                        {{#if price-basis}}
                                                            <span class="price-basis">({{price-basis}})</span>
                                                        {{/if}}
                                                        </span>
                                                    {{/if}}
                                                </label>
                                            </div>
                                            <div class="quantity-controls">
                                                <button type="button" class="quantity-btn minus" data-action="decrease">-</button>
                                                <input type="number" class="quantity-input addon-input" name="{{@key}}" data-label="{{label}}" value="0" min="0" max="0" data-max-based-on-guest="true">
                                                <button type="button" class="quantity-btn plus" data-action="increase">+</button>
                                            </div>
                                        </div>
                                    {{/each}}
                                </div>
                            {{/if}}
                        {{/if}}
                    {{else if (eq htmlType "p")}}
                        <p class="section-content">{{content}}</p>
                    {{/if}}

                    {{! 🟡🟡🟡 - [IMAGES] Handle image elements }}
                    {{#if (eq htmlType "image")}}
                        <div class="image-section">
                            <img src="{{content.src}}" alt="{{content.alt}}" class="menu-image">
                            {{#if content.caption}}
                                <p class="image-caption">{{content.caption}}</p>
                            {{/if}}
                        </div>
                    {{/if}}

                    {{! 🟡🟡🟡 - [UNORDERED LISTS] Handle unordered list elements }}
                    {{#if (eq htmlType "unordered-list")}}
                        <ul class="menu-list">
                            {{#each content}}
                                <li>{{this}}</li>
                            {{/each}}
                        </ul>
                    {{/if}}

                    {{! 🟡🟡🟡 - [RADIO GROUPS] Handle radio button groups }}
                    {{#if (eq htmlType "radio-group")}}
                        <div class="radio-group" data-group-name="{{id}}">
                            {{#each content}}
                                <div class="radio-option contracted" data-option-id="{{@key}}" data-option-label="{{label}}">
                                    <label class="radio-label">
                                        <input type="radio" name="{{../id}}" value="{{@key}}" data-label="{{label}}" class="radio-input">
                                        <div class="radio-custom"></div>
                                        <span class="radio-text">
                                            <strong>{{label}}</strong>
                                            {{#if description}}
                                                <span class="description">{{description}}</span>
                                            {{/if}}
                                            {{#if price}}
                                                <span class="price">AED {{price}}
                                                {{#if price-basis}}
                                                    <span class="price-basis">({{price-basis}})</span>
                                                {{/if}}
                                                </span>
                                            {{/if}}
                                        </span>
                                    </label>
                                    
                                    {{! 🟡🟡🟡 - [POPUP BUTTON] Show details button if popup exists - hidden by default in contracted mode }}
                                    {{#if popup}}
                                        <button type="button" class="view-details-btn" data-popup-target="{{@key}}" style="display: none;">
                                            View Details
                                        </button>
                                    {{/if}}
                                </div>
                            {{/each}}
                        </div>
                    {{/if}}

                    {{! 🟡🟡🟡 - [PRODUCT GROUPS] Handle individual products with quantity counters }}
                    {{#if (eq htmlType "product-group")}}
                        <div class="product-group" data-group-name="{{id}}">
                            {{#each content}}
                                <div class="product-item" data-product-id="{{@key}}" data-product-label="{{label}}">
                                    <div class="product-info">
                                        <label class="product-label">
                                            <strong>{{label}}</strong>
                                            {{#if price}}
                                                <span class="price">AED {{price}}
                                                {{#if price-basis}}
                                                    <span class="price-basis">({{price-basis}})</span>
                                                {{/if}}
                                                </span>
                                            {{/if}}
                                        </label>
                                    </div>
                                    <div class="quantity-controls">
                                        <button type="button" class="quantity-btn minus" data-action="decrease">-</button>
                                        <input type="number" class="quantity-input" name="{{@key}}" data-label="{{label}}" value="0" min="0" max="999">
                                        <button type="button" class="quantity-btn plus" data-action="increase">+</button>
                                    </div>
                                </div>
                            {{/each}}
                        </div>
                    {{/if}}

                    {{! 🟡🟡🟡 - [CHECKBOX GROUPS] Handle checkbox groups }}
                    {{#if (eq htmlType "checkbox-group")}}
                        <div class="checkbox-group" data-group-name="{{id}}">
                            {{#each content}}
                                <div class="checkbox-option" data-option-id="{{@key}}" data-option-label="{{label}}">
                                    <label class="checkbox-label">
                                        <input type="checkbox" name="{{@key}}" value="{{@key}}" data-label="{{label}}" class="checkbox-input">
                                        <span class="checkbox-text">
                                            <strong>{{label}}</strong>
                                            {{#if price}}
                                                <span class="price">AED {{price}}
                                                {{#if price-basis}}
                                                    <span class="price-basis">({{price-basis}})</span>
                                                {{/if}}
                                                </span>
                                            {{/if}}
                                        </span>
                                    </label>
                                    
                                    {{! 🟡🟡🟡 - [POPUP BUTTON] Show details button if popup exists }}
                                    {{#if popup}}
                                        <button type="button" class="view-details-btn" data-popup-target="{{@key}}">
                                            View Details
                                        </button>
                                    {{/if}}
                                </div>
                            {{/each}}
                        </div>
                    {{/if}}

                    {{! 🟡🟡🟡 - [DIV-GROUP] Handle div-group sections (minimum orders) }}
                    {{! ⚠️⚠️⚠️ - [MINIMUM ORDER VISIBILITY] Only show if BOTH guest count AND dates are available }}
                    {{#if (eq htmlType "div-group")}}
                        <div class="div-group" data-group-name="{{id}}" style="{{#unless canShowCalculator}}display: none;{{/unless}}">
                            {{#each content}}
                                {{! 🟡🟡🟡 - [PRICE FILTER] Only render if price is greater than 0 }}
                                {{#if (gt price 0)}}
                                <div class="minimum_order" data-min-order-key="{{@key}}">
                                    <h3>{{label}}</h3>
                                    <p class="min-order-price">AED {{price}}</p>
                                    <p class="min-order-basis">{{price-basis}}</p>
                                </div>
                                {{/if}}
                            {{/each}}
                        </div>
                    {{/if}}
                </div>
            {{/each}}

            {{! 🟡🟡🟡 - KLOI GUEST COUNTER - Will be positioned after first image via JavaScript }}
            <div id="guest-counter-container" style="display: none;">
                <div class="product-item" data-product-id="guest-count">
                    <div class="product-info">
                        <label class="product-label">
                            <strong>Your Guest Count</strong>
                        </label>
                    </div>
                    <div class="quantity-controls">
                        <button type="button" class="quantity-btn minus" data-action="decrease">-</button>
                        <input type="number" class="quantity-input" name="guest-count" value="0" min="0" max="999">
                        <button type="button" class="quantity-btn plus" data-action="increase">+</button>
                    </div>
                </div>
            </div>

            {{! 🟡🟡🟡 - [CALCULATOR CONTAINER] Calculator requires BOTH guest count AND dates for accurate pricing }}
            {{! ⚠️⚠️⚠️ - [CALCULATOR VISIBILITY] Only show if BOTH guest count AND dates are available }}
            <div id="koi-live-quote" style="{{#unless canShowCalculator}}display: none;{{/unless}}">
                <div class="kloi-calculator"></div>
            </div>

            {{! 🟡🟡🟡 - [EDIT DATE BUTTON] Allow users to edit event date by navigating to date picker }}
            {{! ⚠️⚠️⚠️ - [EDIT DATE VISIBILITY] Only show if BOTH guest count AND dates are available }}
            <div id="edit-date" class="edit-date-section" style="{{#unless canShowCalculator}}display: none;{{/unless}}">
                <a href="/date-picker" class="edit-date-btn" title="Edit your selected event date and time">
                    <span class="edit-icon">📅</span>
                    <span class="edit-text">Edit Event Date</span>
                </a>
            </div>

            {{! 🟡🟡🟡 - [FORM SUBMISSION] Submit section }}
            <div class="submit-section">
                <button type="submit" id="submitButton" class="submit-btn btn-active">
                    <span class="summary" id="orderSummary">Please select your menu items</span>
                    <span class="confirm-text">Continue to Summary</span>
                </button>
            </div>
        </form>
    {{/if}}
</div>

{{! 🟡🟡🟡 - [HIDDEN DATA] Server-side data for JavaScript }}
{{! 🟡🟡🟡 - [GUEST COUNT] Pass guest count for calculator visibility control }}
{{! 🟡🟡🟡 - [DATE INFO] Pass date info flags for calculator visibility control }}
{{! 🟡🟡🟡 - [FORM PRE-FILL] Pass eventSetup data for form pre-filling }}
{{! 🟡🟡🟡 - [TAXES FEES] Pass taxes/fees data for calculator }}
{{! ⚠️⚠️⚠️ - [CALCULATOR READINESS] Calculator requires BOTH guest count AND dates }}
<div id="serverData" data-menu-sections="{{menuSectionsJson}}" data-number-of-days="{{numberOfDays}}" data-guest-count="{{guestCount}}" data-has-guest-count="{{hasGuestCount}}" data-has-date-info="{{hasDateInfo}}" data-can-show-calculator="{{canShowCalculator}}" data-event-setup="{{eventSetupJson}}" data-taxes-fees="{{taxesFeesJson}}" style="display: none;"></div>

{{! 🟡🟡🟡 - [POPUP MODAL] Modal for displaying popup content }}
<div id="popupModal" class="popup-modal">
    <div class="popup-content">
        <span class="popup-close">&times;</span>
        <div id="popupBody" class="popup-body">
            {{! Popup content will be dynamically inserted here }}
        </div>
    </div>
    <style scoped>
        #popupBody p {
            margin: 1rem 0;
        }#popupBody ul {
            list-style-type: square;
            margin: 1rem;
        }
    </style>
</div>



{{! 🟡🟡🟡 - [JAVASCRIPT] Event setup functionality }}
<script src="/public/global/js/kloi_calculator.js"></script>
<script src="/public/global/js/calculator-state.js"></script>
<script src="/public/global/js/menu_labels.js"></script>
<script src="/public/global/js/wizard__progress.js"></script>
<script>
// 🟡🟡🟡 - [POPUP DATA] Server-side popup data will be loaded from data attribute

// 🟡🟡🟡 - [EVENT SETUP JS] Main JavaScript for event setup page
document.addEventListener('DOMContentLoaded', function() {
    console.log('🟡🟡🟡 - [EVENT SETUP JS] Event setup page loaded');
    
    // 🟡🟡🟡 - [FORM ELEMENTS] Get form elements
    const form = document.getElementById('eventSetupForm');
    const submitBtn = document.getElementById('submitButton');
    const summarySpan = document.getElementById('orderSummary');
    const popupModal = document.getElementById('popupModal');
    const popupBody = document.getElementById('popupBody');
    const popupClose = document.querySelector('.popup-close');
    
    // 🟡🟡🟡 - [POPUP DATA] Store popup content data
    const popupData = {};

    // 🟡🟡🟡 - [KLOI CALC] Initialize calculator early from server data
    const serverDataDiv = document.getElementById('serverData');
    const menuSectionsData = serverDataDiv?.dataset.menuSections;
    const numberOfDaysData = serverDataDiv?.dataset.numberOfDays;
    const numberOfDays = numberOfDaysData ? parseInt(numberOfDaysData, 10) : 1; // 🔵🔵🔵 - [DEFAULT] Default to 1 if not available
    
    // 🟡🟡🟡 - [GUEST COUNT] Read guest count from server data for calculator visibility
    const guestCountData = serverDataDiv?.dataset.guestCount;
    const hasGuestCountData = serverDataDiv?.dataset.hasGuestCount === 'true';
    const guestCountFromServer = guestCountData ? parseInt(guestCountData, 10) : null;
    
    // 🟡🟡🟡 - [DATE INFO] Read date info from server data for calculator visibility
    // ⚠️⚠️⚠️ - [DATE INFO] Calculator requires BOTH guest count AND dates for accurate pricing
    const hasDateInfoData = serverDataDiv?.dataset.hasDateInfo === 'true';
    const canShowCalculatorData = serverDataDiv?.dataset.canShowCalculator === 'true';
    
    // 🟡🟡🟡 - [TAXES FEES] Read taxes/fees from server data for calculator
    const taxesFeesData = serverDataDiv?.dataset.taxesFees;
    let taxesFeesArray = [];
    if (taxesFeesData && taxesFeesData !== 'null' && taxesFeesData !== '') {
        try {
            taxesFeesArray = JSON.parse(taxesFeesData);
            console.log('✅✅✅ - [EVENT SETUP JS] Taxes/fees loaded from server:', taxesFeesArray.length);
        } catch (e) {
            console.error('❗❗❗ - [EVENT SETUP JS] Error parsing taxes/fees data:', e);
        }
    }
    
    console.log('🟡🟡🟡 - [EVENT SETUP JS] Guest count from server:', guestCountFromServer, 'hasGuestCount:', hasGuestCountData);
    console.log('🟡🟡🟡 - [EVENT SETUP JS] Date info from server:', 'hasDateInfo:', hasDateInfoData, 'canShowCalculator:', canShowCalculatorData);
    
    let calc = null;
    // 2025-11-05T00:00:00Z 🟡🟡🟡 - [MENU LABELS] Initialize label maps for UI-friendly display across pages
    if (menuSectionsData && window.KloiMenuLabels) {
        try {
            window.KloiMenuLabels.initFromMenuSections(menuSectionsData);
            window.KloiMenuLabels.annotateDomLabels(document);
            console.log('✅✅✅ - [EVENT SETUP JS] Menu labels initialized and DOM annotated');
        } catch (e) {
            console.error('❗❗❗ - [EVENT SETUP JS] Menu labels init failed:', e);
        }
    }

    // 🟡🟡🟡 - [CALCULATOR READINESS] Function to check if calculator can be shown
    // ⚠️⚠️⚠️ - [CALCULATOR REQUIREMENTS] Calculator requires BOTH guest count AND dates for accurate pricing
    function checkCalculatorReadiness() {
        const guestCountInput = document.querySelector('input[name="guest-count"]');
        let hasGuestCount = false;
        let hasDates = false;
        
        // 🟡🟡🟡 - [GUEST COUNT CHECK] Check if guest count is available from input or server
        if (guestCountInput) {
            const guestCountValue = parseInt(guestCountInput.value) || 0;
            if (guestCountValue > 0) {
                hasGuestCount = true;
            }
        }
        
        // 🟡🟡🟡 - [GUEST COUNT CHECK] Check server data
        if (!hasGuestCount && hasGuestCountData && guestCountFromServer && guestCountFromServer > 0) {
            hasGuestCount = true;
        }
        
        // 🟡🟡🟡 - [DATE INFO CHECK] Check if dates are available from server
        // ⚠️⚠️⚠️ - [DATE INFO] Dates must come from date-picker route (dateInfo session)
        // For now, we check server data - dates cannot be entered on this page
        hasDates = hasDateInfoData;
        
        // 🟡🟡🟡 - [CALCULATOR READINESS] Both conditions must be true
        const isReady = hasGuestCount && hasDates;
        console.log('🟡🟡🟡 - [EVENT SETUP JS] Calculator readiness check:', { hasGuestCount, hasDates, isReady });
        return isReady;
    }
    
    // 🟡🟡🟡 - [GUEST COUNT CHECK] Helper function for guest count only (used in other contexts)
    function checkGuestCountAvailable() {
        const guestCountInput = document.querySelector('input[name="guest-count"]');
        
        if (guestCountInput) {
            const guestCountValue = parseInt(guestCountInput.value) || 0;
            if (guestCountValue > 0) {
                return true;
            }
        }
        
        if (hasGuestCountData && guestCountFromServer && guestCountFromServer > 0) {
            return true;
        }
        
        return false;
    }
    
    // 🟡🟡🟡 - [CALCULATOR VISIBILITY] Function to show/hide calculator and related elements
    // ⚠️⚠️⚠️ - [CALCULATOR REQUIREMENTS] Calculator requires BOTH guest count AND dates
    function updateCalculatorVisibility() {
        const calculatorContainer = document.getElementById('koi-live-quote');
        const editDateSection = document.getElementById('edit-date');
        const minimumOrderSections = document.querySelectorAll('.div-group');
        
        if (!calculatorContainer) {
            console.warn('⚠️⚠️⚠️ - [EVENT SETUP JS] Calculator container not found');
            return;
        }
        
        const isReady = checkCalculatorReadiness();
        
        // 🟡🟡🟡 - [VISIBILITY CONTROL] Show calculator and related elements if BOTH guest count AND dates are available
        if (isReady) {
            calculatorContainer.style.display = '';
            if (editDateSection) editDateSection.style.display = '';
            minimumOrderSections.forEach(section => {
                section.style.display = '';
            });
            console.log('✅✅✅ - [EVENT SETUP JS] Calculator and related elements shown - guest count and dates available');
        } else {
            calculatorContainer.style.display = 'none';
            if (editDateSection) editDateSection.style.display = 'none';
            minimumOrderSections.forEach(section => {
                section.style.display = 'none';
            });
            console.log('🟡🟡🟡 - [EVENT SETUP JS] Calculator and related elements hidden - guest count or dates not available');
        }
    }
    
    // 🟡🟡🟡 - [CALCULATOR INIT] Only initialize calculator if BOTH guest count AND dates are available
    // ⚠️⚠️⚠️ - [CALCULATOR INIT] Calculator renders immediately on init and requires BOTH conditions
    // ⚠️⚠️⚠️ - [CALCULATOR REQUIREMENTS] Calculator needs dates for accurate pricing (numberOfDays affects calculations)
    const calculatorReadyForInit = checkCalculatorReadiness();
    
    if (menuSectionsData && window.KloiCalculator) {
        if (calculatorReadyForInit) {
            console.log('🟡🟡🟡 - [EVENT SETUP JS] Initializing KLOI calculator with server menu data');
            console.log('🟡🟡🟡 - [EVENT SETUP JS] Number of days from server:', numberOfDays);
            console.log('✅✅✅ - [EVENT SETUP JS] Guest count and dates available, initializing calculator');
            
            calc = window.KloiCalculator.initFromMenuSections(menuSectionsData, { taxesFees: taxesFeesArray, numberOfDays: numberOfDays });
            if (!calc) {
                console.error('❗❗❗ - [EVENT SETUP JS] Calculator failed to initialize');
            } else {
                // 🟡🟡🟡 - [NUMBER OF DAYS] Explicitly set number of days to ensure correct calculation
                // ⚠️⚠️⚠️ - [NUMBER OF DAYS] This ensures calculator uses current session numberOfDays, not any saved state
                calc.setNumberOfDays(numberOfDays);
                console.log('✅✅✅ - [EVENT SETUP JS] Calculator initialized with numberOfDays:', numberOfDays);
                
                // 🟡🟡🟡 - [GUEST COUNT] Set guest count if available from server
                if (guestCountFromServer && guestCountFromServer > 0) {
                    calc.setGuestCount(guestCountFromServer);
                    console.log('✅✅✅ - [EVENT SETUP JS] Guest count set in calculator from server:', guestCountFromServer);
                }
            }
            try { window.__kloiCalc = calc; console.log('⚪⚪⚪ - [EVENT SETUP JS] Global calculator reference set'); } catch(_e) {}
        } else {
            console.log('🟡🟡🟡 - [EVENT SETUP JS] Calculator not ready - guest count or dates not available, calculator will be initialized when both are available');
            // 🟡🟡🟡 - [CALCULATOR DEFERRED INIT] Store menu data for later initialization
            window.__pendingCalculatorInit = {
                menuSectionsData: menuSectionsData,
                numberOfDays: numberOfDays,
                guestCountFromServer: guestCountFromServer,
                hasDateInfo: hasDateInfoData,
                taxesFees: taxesFeesArray
            };
        }
    } else {
        console.error('❗❗❗ - [EVENT SETUP JS] Missing menu data or calculator module');
    }
    
    // 🟡🟡🟡 - [CALCULATOR VISIBILITY] Initial visibility check
    updateCalculatorVisibility();
    
    // 🟡🟡🟡 - [CALCULATOR DEFERRED INIT] Function to initialize calculator when BOTH guest count AND dates become available
    // ⚠️⚠️⚠️ - [CALCULATOR REQUIREMENTS] Calculator requires BOTH conditions for accurate pricing
    function initializeCalculatorIfNeeded() {
        // 🟡🟡🟡 - [READINESS CHECK] Check if calculator is ready (both guest count AND dates)
        const isReady = checkCalculatorReadiness();
        
        if (!isReady) {
            console.log('🟡🟡🟡 - [EVENT SETUP JS] Calculator not ready - waiting for guest count and dates');
            return;
        }
        
        if (!calc && window.__pendingCalculatorInit && window.KloiCalculator) {
            const pending = window.__pendingCalculatorInit;
            console.log('🟡🟡🟡 - [EVENT SETUP JS] Initializing deferred calculator now that guest count and dates are available');
            
            // 🟡🟡🟡 - [DATE INFO CHECK] Ensure dates are available before initializing
            // ⚠️⚠️⚠️ - [DATE INFO] Dates must be from date-picker route, cannot be entered here
            if (!hasDateInfoData && !pending.hasDateInfo) {
                console.log('⚠️⚠️⚠️ - [EVENT SETUP JS] Dates not available, cannot initialize calculator yet');
                return;
            }
            
            // 🟡🟡🟡 - [NUMBER OF DAYS] Get current numberOfDays from server data (may have been updated)
            const currentNumberOfDaysData = serverDataDiv?.dataset.numberOfDays;
            const currentNumberOfDays = currentNumberOfDaysData ? parseInt(currentNumberOfDaysData, 10) : (pending.numberOfDays || 1);
            
            // 🟡🟡🟡 - [TAXES FEES] Get current taxes/fees from server data (may have been updated)
            const currentTaxesFeesData = serverDataDiv?.dataset.taxesFees;
            let currentTaxesFees = pending.taxesFees || [];
            if (currentTaxesFeesData && currentTaxesFeesData !== 'null' && currentTaxesFeesData !== '') {
                try {
                    currentTaxesFees = JSON.parse(currentTaxesFeesData);
                } catch (e) {
                    console.error('❗❗❗ - [EVENT SETUP JS] Error parsing taxes/fees in deferred init:', e);
                }
            }
            
            calc = window.KloiCalculator.initFromMenuSections(pending.menuSectionsData, { taxesFees: currentTaxesFees, numberOfDays: currentNumberOfDays });
            if (calc) {
                // 🟡🟡🟡 - [NUMBER OF DAYS] Explicitly set number of days to ensure correct calculation
                // ⚠️⚠️⚠️ - [NUMBER OF DAYS] This ensures calculator uses current session numberOfDays, not any saved state
                calc.setNumberOfDays(currentNumberOfDays);
                console.log('✅✅✅ - [EVENT SETUP JS] Deferred calculator initialized with numberOfDays:', currentNumberOfDays);
                
                // 🟡🟡🟡 - [GUEST COUNT] Set guest count from input or server
                const guestCountInput = document.querySelector('input[name="guest-count"]');
                const guestCountValue = guestCountInput ? parseInt(guestCountInput.value) || 0 : (pending.guestCountFromServer || 0);
                if (guestCountValue > 0) {
                    calc.setGuestCount(guestCountValue);
                    console.log('✅✅✅ - [EVENT SETUP JS] Guest count set in deferred calculator:', guestCountValue);
                }
                
                // 🟡🟡🟡 - [CALCULATOR STATE] Restore calculator state from eventSetup data if available, otherwise read from form
                // 2025-12-20T00:00:00Z 🟡🟡🟡 - [DRY REFACTOR] Using calculator-state module when eventSetup data is available
                const eventSetupJsonAttr = serverDataDiv?.getAttribute('data-event-setup');
                if (eventSetupJsonAttr && eventSetupJsonAttr !== 'null' && window.KloiCalculatorState && window.KloiCalculatorState.restoreCalculatorState) {
                    try {
                        const eventSetup = JSON.parse(eventSetupJsonAttr);
                        console.log('🟡🟡🟡 - [EVENT SETUP JS] Restoring calculator state from eventSetup data in deferred init');
                        window.KloiCalculatorState.restoreCalculatorState(calc, eventSetup, { skipGuestCount: false, skipProducts: false });
                        calc.setNumberOfDays(currentNumberOfDays);
                        calc.recalc();
                        console.log('✅✅✅ - [EVENT SETUP JS] Calculator state restored from eventSetup data in deferred init');
                    } catch (e) {
                        console.error('❗❗❗ - [EVENT SETUP JS] Error restoring calculator state from eventSetup in deferred init:', e);
                        // Fallback to reading from form
                        restoreCalculatorFromFormInDeferredInit();
                    }
                } else {
                    // 🟡🟡🟡 - [FORM VALUES] Read pre-filled form values and set in calculator (fallback)
                    restoreCalculatorFromFormInDeferredInit();
                }
                
                function restoreCalculatorFromFormInDeferredInit() {
                    // Radios
                    const selectedRadios = document.querySelectorAll('input[type="radio"]:checked');
                    selectedRadios.forEach(r => calc.setRadio(r.name, r.value));
                    
                    // Checkboxes
                    const selectedCheckboxes = document.querySelectorAll('input[type="checkbox"]:checked');
                    selectedCheckboxes.forEach(cb => calc.setCheckbox(cb.value, true));
                    
                    // Products (including addon items)
                    const productInputs = document.querySelectorAll('.product-group .quantity-input, .addon-group .quantity-input');
                    productInputs.forEach(pi => {
                        const qty = parseInt(pi.value) || 0;
                        if (qty > 0 || pi.name === 'guest-count') {
                            calc.setProductQty(pi.name, qty);
                        }
                    });
                    
                    calc.setNumberOfDays(currentNumberOfDays);
                    calc.recalc();
                }
                
                try { window.__kloiCalc = calc; } catch(_e) {}
                delete window.__pendingCalculatorInit;
                console.log('✅✅✅ - [EVENT SETUP JS] Deferred calculator initialized successfully with guest count, dates, and pre-filled form values');
            }
        }
    }
    
    // 🟡🟡🟡 - [POPUP INITIALIZATION] Initialize popup data from server data
    function initializePopupData() {
        console.log('🟡🟡🟡 - [EVENT SETUP JS] Initializing popup data from server');
        
        // 🟡🟡🟡 - [SERVER DATA] Get server data from hidden div
        if (menuSectionsData) {
            try {
                const serverPopupData = JSON.parse(menuSectionsData);
                console.log('🟡🟡🟡 - [EVENT SETUP JS] Parsed server data:', serverPopupData.length, 'sections');
                
                // 🟡🟡🟡 - [SERVER DATA] Process server-side popup data
                serverPopupData.forEach(section => {
                    // 🟡🟡🟡 - [POPUP PROCESSING] Check if this section has content with popups
                    if (section.content && typeof section.content === 'object') {
                        Object.entries(section.content).forEach(([optionKey, optionData]) => {
                            // 🟡🟡🟡 - [POPUP CHECK] Check if this option has popup data
                            if (optionData && typeof optionData === 'object' && optionData.popup) {
                                const popupKey = `${section.id}.${optionKey}`;
                                popupData[popupKey] = {
                                     // 🟡🟡🟡 Use "label" value from JSONB if available
                                    title: optionData.label || optionKey,
                                    content: optionData.popup
                                };
                                console.log('🟡🟡🟡 - [EVENT SETUP JS] Found popup for:', popupKey);
                            }
                        });
                    }
                });
            } catch (error) {
                console.error('❗❗❗ - [EVENT SETUP JS] Error parsing server data:', error);
            }
        }
        
        // 🟡🟡🟡 - [DOM ELEMENTS] Add click handlers to popup buttons
        const popupButtons = document.querySelectorAll('.view-details-btn');
        popupButtons.forEach(btn => {
            const popupTarget = btn.dataset.popupTarget;
            const section = btn.closest('.menu-section');
            const sectionId = section.dataset.sectionId;
            const popupKey = `${sectionId}.${popupTarget}`;
            
            btn.addEventListener('click', () => showPopup(popupKey));
        });
        
        console.log('✅✅✅ - [EVENT SETUP JS] Popup data initialized:', Object.keys(popupData).length, 'popups');
    }
    
    // 🟡🟡🟡 - [POPUP DISPLAY] Show popup modal
    function showPopup(popupKey) {
        console.log('🟡🟡🟡 - [EVENT SETUP JS] Showing popup for:', popupKey);
        
        const popup = popupData[popupKey];
        if (popup) {
            // 🟡🟡🟡 - [POPUP RENDERING] Render popup content based on structure
            let popupHTML = `<h3>${popup.title}</h3>`;
            
            if (typeof popup.content === 'object') {
                // 🟡🟡🟡 - [STRUCTURED CONTENT] Handle structured popup content
                Object.entries(popup.content).forEach(([sectionKey, sectionData]) => {
                    console.log('🟡🟡🟡 - [EVENT SETUP JS] Rendering popup section:', sectionKey, sectionData);
                    
                    if (sectionData['html-type'] === 'image') {
                        popupHTML += `
                            <div class="popup-image">
                                <img src="${sectionData.src}" alt="${sectionData.alt || ''}" style="max-width: 100%; height: auto;">
                                ${sectionData.caption ? `<p class="popup-caption">${sectionData.caption}</p>` : ''}
                            </div>
                        `;
                    } else if (sectionData['html-type'] === 'p') {
                        popupHTML += `<p>${sectionData.content}</p>`;
                    } else if (sectionData['html-type'] === 'unordered-list') {
                        popupHTML += `
                            <ul>
                                ${sectionData.content.map(item => `<li>${item}</li>`).join('')}
                            </ul>
                        `;
                    }
                });
            } else {
                // 🟡🟡🟡 - [SIMPLE CONTENT] Handle simple string content
                popupHTML += `<div>${popup.content}</div>`;
            }
            
            popupBody.innerHTML = popupHTML;
            popupModal.style.display = 'block';
        }
    }
    
