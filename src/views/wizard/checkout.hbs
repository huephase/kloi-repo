{{!-- 🟡🟡🟡 - [2025-01-XX] Checkout page with Stripe Payment Element + Appearance API integration --}}

{{! 🟡🟡🟡 - [STYLESHEET] Checkout page specific styles }}
<link rel="stylesheet" href="/public/global/css/checkout.css">

<div class="{{page_class}} wizard-step checkout">
  <header class="page-header">
    <h1>Checkout</h1>
    <p>Review your order and complete payment to confirm your booking.</p>
  </header>

  <div class="checkout-container">
    {{!-- Order Summary Section --}}
    <section class="checkout-section order-summary">
      <h2>Order Summary</h2>
      
      {{!-- Location --}}
      <div class="summary-item">
        <h3>Location</h3>
        <div class="summary-content">
          <p><strong>Address:</strong> {{locationData.fullAddress}}</p>
          {{#if locationData.components.sublocality}}
            <p><strong>Area:</strong> {{locationData.components.sublocality}}</p>
          {{/if}}
          {{#if locationData.city}}
            <p><strong>City:</strong> {{locationData.city}}</p>
          {{/if}}
        </div>
      </div>

      {{!-- Customer Information --}}
      <div class="summary-item">
        <h3>Customer Information</h3>
        <div class="summary-content">
          <p><strong>Name:</strong> {{eventDetails.firstName}} {{eventDetails.lastName}}</p>
          <p><strong>Phone:</strong> {{eventDetails.phone}}</p>
          {{#if eventDetails.email}}
            <p><strong>Email:</strong> {{eventDetails.email}}</p>
          {{/if}}
        </div>
      </div>

      {{!-- Event Details --}}
      {{#if dateInfo}}
        <div class="summary-item">
          <h3>Event Dates</h3>
          <div class="summary-content">
            {{#if dateInfo.dates}}
              <p><strong>Dates:</strong> {{#each dateInfo.dates}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
            {{/if}}
            {{#if dateInfo.startTime}}
              <p><strong>Start Time:</strong> {{dateInfo.startTime}}</p>
            {{/if}}
            {{#if dateInfo.endTime}}
              <p><strong>End Time:</strong> {{dateInfo.endTime}}</p>
            {{/if}}
          </div>
        </div>
      {{/if}}

      {{!-- Price Breakdown --}}
      <div class="summary-item price-breakdown">
        <h3>Price Breakdown</h3>
        <div class="summary-content">
          <div class="price-row">
            <span>Subtotal:</span>
            <span>{{currency}} {{order.subtotalFormatted}}</span>
          </div>
          <div class="price-row">
            <span>Delivery Surcharge:</span>
            <span>{{currency}} {{order.surchargeFormatted}}</span>
          </div>
          <div class="price-row total">
            <span><strong>Grand Total:</strong></span>
            <span><strong>{{currency}} {{order.totalAmountFormatted}}</strong></span>
          </div>
        </div>
      </div>

      <div class="order-info">
        <p><strong>Order Number:</strong> #{{order.orderNumber}}</p>
      </div>
    </section>

    {{!-- Payment Form Section --}}
    <section class="checkout-section payment-form">
      <h2>Payment Information</h2>
      
      <form id="payment-form">
        {{!-- Stripe Payment Element Container --}}
        <div class="form-group">
          <div id="payment-element" class="stripe-element">
            {{!-- Stripe Payment Element will mount here --}}
          </div>
          <div id="card-errors" class="form-error" role="alert"></div>
        </div>

        {{!-- Cardholder Name (Optional) --}}
        <div class="form-group">
          <label for="cardholder-name">Cardholder Name (Optional)</label>
          <input type="text" id="cardholder-name" placeholder="Name on card" />
        </div>

        {{!-- Email (Required) --}}
        <div class="form-group">
          <label for="checkout-email">Email <span style="color: red;">*</span></label>
          <input type="email" id="checkout-email" name="email" value="{{eventDetails.email}}" placeholder="your.email@example.com" required />
          <div id="email-error" class="form-error" style="display: none;"></div>
        </div>

        {{!-- Payment Button --}}
        <button type="submit" id="submit-button" class="pill-bt primary">
          <span id="button-text">Pay {{currency}} {{order.totalAmountFormatted}}</span>
          <span id="button-spinner" class="spinner" style="display: none;">Processing...</span>
        </button>

        {{!-- Error Message Display --}}
        <div id="payment-error" class="form-error" style="display: none;"></div>
      </form>
    </section>
  </div>
</div>

{{!-- Stripe.js Library --}}
<script src="https://js.stripe.com/v3/"></script>
{{!-- 🟡🟡🟡 - [WIZARD PROGRESS] Include wizard progress module for email autosave --}}
<script src="/public/global/js/wizard__progress.js"></script>

<script>
  // 🟡🟡🟡 - [2025-01-XX] Stripe Payment Element + Appearance API integration
  (function() {
    console.log('🟡🟡🟡 - [CHECKOUT] Initializing Stripe Payment Element');

    // 🟡🟡🟡 - [STRIPE INIT] Initialize Stripe with publishable key
    const stripePublishableKey = '{{stripePublishableKey}}';
    const clientSecret = '{{clientSecret}}';
    const paymentIntentId = '{{paymentIntentId}}';
    const orderId = '{{order.id}}';

    if (!stripePublishableKey || !clientSecret) {
      console.error('❗❗❗ - [CHECKOUT] Stripe configuration missing');
      document.getElementById('payment-error').textContent = 'Payment system not configured. Please contact support.';
      document.getElementById('payment-error').style.display = 'block';
      return;
    }

    const stripe = Stripe(stripePublishableKey);

    // 🟡🟡🟡 - [EMAIL VALIDATION] Initialize email validation and button state management
    const emailInput = document.getElementById('checkout-email');
    const emailError = document.getElementById('email-error');
    const submitButton = document.getElementById('submit-button');
    const buttonText = document.getElementById('button-text');
    const currency = '{{currency}}';
    const totalAmountFormatted = '{{order.totalAmountFormatted}}';
    
    // 🟡🟡🟡 - [EMAIL STATE] Get initial email from session/eventDetails
    const initialEmail = emailInput ? emailInput.value.trim() : '';
    let currentEmail = initialEmail;
    
    console.log('🟡🟡🟡 - [CHECKOUT] Initial email from session:', initialEmail ? 'Present' : 'Missing');
    
    // 🟡🟡🟡 - [EMAIL VALIDATION] Email validation function
    function validateEmail(email) {
      if (!email || email.trim() === '') {
        return { valid: false, message: 'Email is required to continue payment' };
      }
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email.trim())) {
        return { valid: false, message: 'Please enter a valid email address' };
      }
      return { valid: true, message: '' };
    }
    
    // 🟡🟡🟡 - [BUTTON STATE] Update submit button state based on email validity
    function updateSubmitButtonState() {
      const emailValidation = validateEmail(currentEmail);
      const isEmailValid = emailValidation.valid;
      
      if (submitButton && buttonText) {
        if (isEmailValid) {
          // ✅✅✅ - [BUTTON STATE] Email is valid, enable submit and show payment text
          submitButton.disabled = false;
          buttonText.textContent = 'Pay ' + currency + ' ' + totalAmountFormatted;
          console.log('✅✅✅ - [CHECKOUT] Email valid, submit button enabled');
        } else {
          // ⚠️⚠️⚠️ - [BUTTON STATE] Email is missing/invalid, disable submit and show prompt text
          submitButton.disabled = true;
          buttonText.textContent = 'Provide your email to continue payment';
          console.log('⚠️⚠️⚠️ - [CHECKOUT] Email missing/invalid, submit button disabled');
        }
      }
      
      // 🟡🟡🟡 - [EMAIL ERROR] Show/hide email error message
      if (emailError) {
        if (!isEmailValid && currentEmail.trim() !== '') {
          emailError.textContent = emailValidation.message;
          emailError.style.display = 'block';
        } else {
          emailError.textContent = '';
          emailError.style.display = 'none';
        }
      }
    }
    
    // 🟡🟡🟡 - [EMAIL SAVE] Save email to session when provided (using wizard progress module)
    function saveEmailToSession(email) {
      if (!email || email.trim() === '') {
        return;
      }
      
      // 🟡🟡🟡 - [EMAIL SAVE] Only save if email has changed
      if (email.trim() === initialEmail) {
        console.log('🟡🟡🟡 - [CHECKOUT] Email unchanged, skipping save');
        return;
      }
      
      console.log('🟡🟡🟡 - [CHECKOUT] Saving email to session via event-details step');
      
      // 🟡🟡🟡 - [EMAIL SAVE] Use wizard progress module to save email to eventDetails session
      if (window.KloiWizardProgress && window.KloiWizardProgress.saveWizardStep) {
        const emailPayload = { email: email.trim() };
        // 🟡🟡🟡 - [EMAIL SAVE] saveWizardStep is async, handle promise
        window.KloiWizardProgress.saveWizardStep('event-details', emailPayload, { autosave: true })
          .then(function(result) {
            if (result && result.ok) {
              console.log('✅✅✅ - [CHECKOUT] Email saved to session successfully');
            } else {
              console.warn('⚠️⚠️⚠️ - [CHECKOUT] Email save to session failed:', result?.json?.message || 'Unknown error');
            }
          })
          .catch(function(error) {
            console.error('❗❗❗ - [CHECKOUT] Error saving email to session:', error);
          });
      } else {
        console.warn('⚠️⚠️⚠️ - [CHECKOUT] Wizard progress module not available, cannot save email');
      }
    }
    
    // 🟡🟡🟡 - [EMAIL INPUT] Set up email input event listeners
    if (emailInput) {
      // 🟡🟡🟡 - [EMAIL INPUT] Handle input changes with debounce for autosave
      let emailSaveTimeout;
      emailInput.addEventListener('input', function() {
        currentEmail = this.value.trim();
        updateSubmitButtonState();
        
        // 🟡🟡🟡 - [EMAIL SAVE] Debounce email save to avoid excessive API calls
        clearTimeout(emailSaveTimeout);
        emailSaveTimeout = setTimeout(function() {
          if (validateEmail(currentEmail).valid) {
            saveEmailToSession(currentEmail);
          }
        }, 1000); // 🟡🟡🟡 - [EMAIL SAVE] Wait 1 second after user stops typing
      });
      
      // 🟡🟡🟡 - [EMAIL INPUT] Handle blur event for immediate validation feedback
      emailInput.addEventListener('blur', function() {
        currentEmail = this.value.trim();
        updateSubmitButtonState();
        
        // 🟡🟡🟡 - [EMAIL SAVE] Save immediately on blur if valid
        if (validateEmail(currentEmail).valid) {
          saveEmailToSession(currentEmail);
        }
      });
      
      // 🟡🟡🟡 - [EMAIL INPUT] Initial button state update
      updateSubmitButtonState();
    }

    // 🟡🟡🟡 - [3D SECURE RETURN] Handle return from 3D Secure authentication
    const urlParams = new URLSearchParams(window.location.search);
    const paymentIntentClientSecret = urlParams.get('payment_intent_client_secret');
    if (paymentIntentClientSecret) {
      console.log('🟡🟡🟡 - [CHECKOUT] Detected return from 3D Secure authentication');
      stripe.retrievePaymentIntent(paymentIntentClientSecret).then(function({ paymentIntent }) {
        if (paymentIntent && paymentIntent.status === 'succeeded') {
          console.log('✅✅✅ - [CHECKOUT] Payment succeeded after 3D Secure:', paymentIntent.id);
          // 🟡🟡🟡 - [SUCCESS] Redirect to confirmation page
          window.location.href = '/final-confirmation?order=' + orderId;
        } else {
          console.error('❗❗❗ - [CHECKOUT] Payment failed after 3D Secure:', paymentIntent?.status);
          const paymentError = document.getElementById('payment-error');
          paymentError.textContent = 'Payment authentication failed. Please try again.';
          paymentError.style.display = 'block';
        }
      }).catch(function(error) {
        console.error('❗❗❗ - [CHECKOUT] Error retrieving payment intent:', error);
        const paymentError = document.getElementById('payment-error');
        paymentError.textContent = 'An error occurred while verifying payment. Please contact support.';
        paymentError.style.display = 'block';
      });
      return; // 🟡🟡🟡 - [2025-01-XX] Exit early if handling 3D Secure return
    }

    // 🟡🟡🟡 - [STRIPE APPEARANCE] Configure appearance API for larger, accessible typography
    const appearance = {
      theme: 'stripe',
      variables: {
        fontFamily: 'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
        fontSizeBase: '18px',
        colorText: '#1f2933',
      },
      rules: {
        '.Input': {
          fontSize: '18px',
        },
        '.Label': {
          fontSize: '16px',
        },
      },
    };

    // 🟡🟡🟡 - [STRIPE ELEMENTS] Initialize Elements with clientSecret + appearance
    const elements = stripe.elements({
      clientSecret: clientSecret,
      appearance: appearance,
    });

    // 🟡🟡🟡 - [STRIPE PAYMENT ELEMENT] Create and mount Payment Element
    const paymentElement = elements.create('payment', {
      layout: 'tabs', // 🟡🟡🟡 - [2025-01-XX] Use tabs layout (alternatives: 'accordion', 'accordion_preselected')
    });

    paymentElement.mount('#payment-element');

    // 🟡🟡🟡 - [STRIPE PAYMENT ELEMENT] Handle real-time validation errors
    paymentElement.on('change', function(event) {
      const displayError = document.getElementById('card-errors');
      if (event.error) {
        displayError.textContent = event.error.message;
        displayError.style.display = 'block';
      } else {
        displayError.textContent = '';
        displayError.style.display = 'none';
      }
    });

    // 🟡🟡🟡 - [PAYMENT FORM] Handle form submission
    const form = document.getElementById('payment-form');
    form.addEventListener('submit', async function(event) {
      event.preventDefault();

      console.log('🟡🟡🟡 - [CHECKOUT] Payment form submitted');

      // 🟡🟡🟡 - [EMAIL VALIDATION] Validate email before proceeding with payment
      const emailValue = emailInput ? emailInput.value.trim() : '';
      const emailValidation = validateEmail(emailValue);
      
      if (!emailValidation.valid) {
        console.error('❗❗❗ - [CHECKOUT] Email validation failed:', emailValidation.message);
        if (emailError) {
          emailError.textContent = emailValidation.message;
          emailError.style.display = 'block';
        }
        updateSubmitButtonState();
        return;
      }
      
      // 🟡🟡🟡 - [EMAIL SAVE] Ensure email is saved to session before payment
      saveEmailToSession(emailValue);

      // 🟡🟡🟡 - [UI STATE] Disable submit button and show loading state
      const buttonSpinner = document.getElementById('button-spinner');
      const paymentError = document.getElementById('payment-error');

      submitButton.disabled = true;
      buttonText.style.display = 'none';
      buttonSpinner.style.display = 'inline-block';
      paymentError.style.display = 'none';
      paymentError.textContent = '';

      try {
        // 🟡🟡🟡 - [STRIPE ELEMENTS] Submit elements first to trigger validation and wallet collection
        // ⚠️⚠️⚠️ - [2025-01-XX] Must call elements.submit() before confirmPayment() for deferred payments
        const { error: submitError } = await elements.submit();
        
        if (submitError) {
          // 🟡🟡🟡 - [ERROR HANDLING] Elements validation failed
          console.error('❗❗❗ - [CHECKOUT] Elements validation error:', submitError);
          paymentError.textContent = submitError.message || 'Please check your payment details.';
          paymentError.style.display = 'block';
          
          // 🟡🟡🟡 - [UI STATE] Re-enable submit button
          submitButton.disabled = false;
          buttonText.style.display = 'inline-block';
          buttonSpinner.style.display = 'none';
          return;
        }

        // 🟡🟡🟡 - [STRIPE CONFIRM] Get cardholder name if provided
        const cardholderName = document.getElementById('cardholder-name').value;
        
        // 🟡🟡🟡 - [STRIPE CONFIRM] Get email for billing details (required for confirmations)
        const customerEmail = emailInput ? emailInput.value.trim() : '';

        // 🟡🟡🟡 - [STRIPE CONFIRM] Build return URL for 3D Secure redirects
        const returnUrl = window.location.origin + window.location.pathname + '?order=' + orderId;

        // 🟡🟡🟡 - [STRIPE CONFIRM] Confirm payment with Stripe Payment Element
        const { error: stripeError, paymentIntent } = await stripe.confirmPayment({
          elements,
          clientSecret: clientSecret,
          redirect: 'if_required', // 🟡🟡🟡 - [2025-01-XX] Only redirect if 3D Secure is required
          confirmParams: {
            return_url: returnUrl, // 🟡🟡🟡 - [2025-01-XX] Required for 3D Secure redirects
            payment_method_data: {
              billing_details: {
                name: cardholderName || undefined,
                email: customerEmail || undefined, // 🟡🟡🟡 - [EMAIL] Include email in billing details for confirmations
              },
            },
          },
        });

        if (stripeError) {
          // 🟡🟡🟡 - [ERROR HANDLING] Payment failed
          console.error('❗❗❗ - [CHECKOUT] Stripe error:', stripeError);
          paymentError.textContent = stripeError.message || 'Payment failed. Please try again.';
          paymentError.style.display = 'block';
          
          // 🟡🟡🟡 - [UI STATE] Re-enable submit button
          submitButton.disabled = false;
          buttonText.style.display = 'inline-block';
          buttonSpinner.style.display = 'none';
        } else if (paymentIntent && paymentIntent.status === 'succeeded') {
          // 🟡🟡🟡 - [SUCCESS] Payment succeeded
          console.log('✅✅✅ - [CHECKOUT] Payment succeeded:', paymentIntent.id);
          
          // 🟡🟡🟡 - [SUCCESS] Show success message
          buttonText.textContent = 'Payment Successful!';
          buttonSpinner.style.display = 'none';
          
          // 🟡🟡🟡 - [SUCCESS] Redirect to confirmation page after short delay
          setTimeout(function() {
            window.location.href = '/final-confirmation?order=' + orderId;
          }, 1500);
        } else {
          // 🟡🟡🟡 - [ERROR HANDLING] Unexpected payment status
          console.warn('⚠️⚠️⚠️ - [CHECKOUT] Unexpected payment status:', paymentIntent?.status);
          paymentError.textContent = 'Payment status is ' + (paymentIntent?.status || 'unknown') + '. Please contact support.';
          paymentError.style.display = 'block';
          
          submitButton.disabled = false;
          buttonText.style.display = 'inline-block';
          buttonSpinner.style.display = 'none';
        }
      } catch (error) {
        // 🟡🟡🟡 - [ERROR HANDLING] Network or other error
        console.error('❗❗❗ - [CHECKOUT] Payment error:', error);
        paymentError.textContent = 'An error occurred. Please try again.';
        paymentError.style.display = 'block';
        
        submitButton.disabled = false;
        buttonText.style.display = 'inline-block';
        buttonSpinner.style.display = 'none';
      }
    });

    console.log('✅✅✅ - [CHECKOUT] Stripe Payment Element initialized');
  })();
</script>

