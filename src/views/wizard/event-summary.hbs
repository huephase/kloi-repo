{{!-- 🟡🟡🟡 - [EVENT SUMMARY VIEW] Semantic summary page using app theme/layout --}}

{{! 🟡🟡🟡 - [STYLESHEET] Event summary specific styles }}
<link rel="stylesheet" href="/public/global/css/event_summary.css">

<div class="{{page_class}} wizard-step event-summary">
  <header class="page-header">
    <h1>Event Summary</h1>
    <a href="#summary-event-setup" class="skip-to-content">VIEW YOUR QUOTATION</a>
  </header>

  <section class="summary-section" id="summary-location">
    <h2>Location</h2>
    {{{renderLocation}}}
    <div class="actions">
      <a class="edit-btn" href="/location" data-step="location">Edit LOCATION</a>
    </div>
  </section>

  <section class="summary-section" id="summary-customer">
    <h2>Customer</h2>
    {{{renderCustomer}}}
    <div class="actions">
      <a class="edit-btn" href="/event-details" data-step="event-details">Edit CUSTOMER</a>
    </div>
  </section>

  <section class="summary-section" id="summary-event-details">
    <h2>Event Details</h2>
    {{{renderEventDetails}}}
    <div class="actions">
      <a class="edit-btn" href="/event-details" data-step="event-details">Edit EVENT DETAILS</a>
    </div>
  </section>

  <section class="summary-section" id="summary-date">
    <h2>Date Selection</h2>
    {{{renderDate}}}
    <div class="actions">
      <a class="edit-btn" href="/date-picker" data-step="date">Edit DATE</a>
    </div>
  </section>

  <section class="summary-section" id="summary-event-setup">
    <h2>Event Setup</h2>
    {{{renderEventSetup}}}
    
    {{! 🟡🟡🟡 - [LIVE CALCULATOR] Display live calculator if all required data is available }}
    {{! ⚠️⚠️⚠️ - [CALCULATOR REQUIREMENTS] Calculator requires menu sections, guest count, and dates }}
    {{#if canShowCalculator}}
    <div id="koi-live-quote-summary" class="calculator-summary-section">
      <h3>Live Quote</h3>
      <div class="kloi-calculator"></div>
    </div>
    {{/if}}
    
    <div class="actions">
      <a class="edit-btn" href="/event-setup" data-step="event">Edit EVENT SETUP</a>
    </div>
  </section>

  <div class="actions checkout">
    <a href="/checkout" class="button" id="checkoutBtn">PROCEED TO CHECKOUT</a>
  </div>
</div>

{{! 🟡🟡🟡 - [HIDDEN DATA] Server-side data for calculator initialization }}
{{#if canShowCalculator}}
<div id="summaryServerData" data-menu-sections="{{menuSectionsJson}}" data-number-of-days="{{numberOfDays}}" data-guest-count="{{guestCount}}" data-event-setup="{{eventSetupJson}}" data-taxes-fees="{{taxesFeesJson}}" style="display: none;"></div>
{{/if}}

<script src="/public/global/js/kloi_calculator.js"></script>
<script src="/public/global/js/menu_labels.js"></script>
<script src="/public/global/js/calculator-state.js"></script>
<script src="/public/global/js/wizard__progress.js"></script>
<script>
  // 🟡🟡🟡 - [EVENT SUMMARY VIEW] Initialize client-side handlers
  document.addEventListener('DOMContentLoaded', function() {
    console.log('🟡🟡🟡 - [EVENT SUMMARY VIEW] Loaded with theme:', '{{theme}}');

    // 🟡🟡🟡 - [LIVE CALCULATOR] Initialize calculator if all required data is available
    {{#if canShowCalculator}}
    try {
      const summaryServerData = document.getElementById('summaryServerData');
      if (summaryServerData && window.KloiCalculator) {
        const menuSectionsJson = summaryServerData.dataset.menuSections;
        const numberOfDaysData = summaryServerData.dataset.numberOfDays;
        const guestCountData = summaryServerData.dataset.guestCount;
        const taxesFeesData = summaryServerData.dataset.taxesFees;
        
        const numberOfDays = numberOfDaysData ? parseInt(numberOfDaysData, 10) : 1;
        const guestCount = guestCountData ? parseInt(guestCountData, 10) : null;
        
        // 🟡🟡🟡 - [TAXES FEES] Parse taxes/fees from server data
        let taxesFeesArray = [];
        if (taxesFeesData && taxesFeesData !== 'null' && taxesFeesData !== '') {
            try {
                taxesFeesArray = JSON.parse(taxesFeesData);
                console.log('✅✅✅ - [EVENT SUMMARY VIEW] Taxes/fees loaded:', taxesFeesArray.length);
            } catch (e) {
                console.error('❗❗❗ - [EVENT SUMMARY VIEW] Error parsing taxes/fees data:', e);
            }
        }
        
        console.log('🟡🟡🟡 - [EVENT SUMMARY VIEW] Initializing calculator:', { numberOfDays, guestCount, numberOfDaysData });
        
        if (menuSectionsJson && menuSectionsJson !== 'null' && guestCount && guestCount > 0) {
          // 🟡🟡🟡 - [MENU LABELS] Initialize menu labels first
          if (window.KloiMenuLabels) {
            try {
              window.KloiMenuLabels.initFromMenuSections(menuSectionsJson);
              window.KloiMenuLabels.annotateDomLabels(document);
              console.log('✅✅✅ - [EVENT SUMMARY VIEW] Menu labels initialized');
            } catch (e) {
              console.error('❗❗❗ - [EVENT SUMMARY VIEW] Menu labels init failed:', e);
            }
          }
          
          // 🟡🟡🟡 - [CALCULATOR INIT] Initialize calculator (initFromMenuSections accepts JSON string or object)
          const calc = window.KloiCalculator.initFromMenuSections(menuSectionsJson, { taxesFees: taxesFeesArray, numberOfDays: numberOfDays });
          if (calc) {
            // 🟡🟡🟡 - [NUMBER OF DAYS] Explicitly set number of days to ensure correct calculation
            // ⚠️⚠️⚠️ - [NUMBER OF DAYS] This ensures calculator uses current session numberOfDays, not any saved state
            calc.setNumberOfDays(numberOfDays);
            console.log('✅✅✅ - [EVENT SUMMARY VIEW] Calculator initialized with numberOfDays:', numberOfDays);
            
            // 🟡🟡🟡 - [GUEST COUNT] Set guest count
            calc.setGuestCount(guestCount);
            console.log('✅✅✅ - [EVENT SUMMARY VIEW] Calculator initialized with guest count:', guestCount);
            
            // 🟡🟡🟡 - [CALCULATOR STATE] Restore calculator state from session using centralized module
            // 2025-12-20T00:00:00Z 🟡🟡🟡 - [DRY REFACTOR] Using KloiCalculatorState.restoreCalculatorState() instead of duplicated logic
            const eventSetupJsonAttr = summaryServerData.getAttribute('data-event-setup');
            if (eventSetupJsonAttr && eventSetupJsonAttr !== 'null') {
              try {
                const eventSetup = JSON.parse(eventSetupJsonAttr);
                console.log('🟡🟡🟡 - [EVENT SUMMARY VIEW] EventSetup data:', eventSetup);
                
                // 🟡🟡🟡 - [CALCULATOR STATE RESTORATION] Use centralized restoration module
                if (window.KloiCalculatorState && window.KloiCalculatorState.restoreCalculatorState) {
                  window.KloiCalculatorState.restoreCalculatorState(calc, eventSetup, { skipGuestCount: false, skipProducts: false });
                } else {
                  console.warn('⚠️⚠️⚠️ - [EVENT SUMMARY VIEW] Calculator state module not available, falling back to manual restoration');
                  // Fallback to manual restoration if module not loaded
                  if (eventSetup.calculator) {
                    if (eventSetup.calculator.radios) {
                      Object.entries(eventSetup.calculator.radios).forEach(([groupId, optionKey]) => {
                        calc.setRadio(groupId, optionKey);
                      });
                    }
                    if (eventSetup.calculator.checkboxes) {
                      eventSetup.calculator.checkboxes.forEach(optionKey => calc.setCheckbox(optionKey, true));
                    }
                    if (eventSetup.calculator.products) {
                      Object.entries(eventSetup.calculator.products).forEach(([productKey, qty]) => {
                        if (productKey !== 'guest-count') calc.setProductQty(productKey, qty);
                      });
                    }
                  }
                }
                
                // 🟡🟡🟡 - [NUMBER OF DAYS] Explicitly set number of days again after state restoration
                // ⚠️⚠️⚠️ - [NUMBER OF DAYS] This ensures calculator uses current session numberOfDays, not any saved state value
                calc.setNumberOfDays(numberOfDays);
                
                // 🟡🟡🟡 - [FINAL RECALC] Ensure calculator recalculates with correct numberOfDays after state restoration
                // ⚠️⚠️⚠️ - [NUMBER OF DAYS] This ensures final calculation uses current session numberOfDays, not any saved state value
                calc.recalc();
                console.log('✅✅✅ - [EVENT SUMMARY VIEW] Calculator state restored from session and recalculated with numberOfDays:', numberOfDays);
              } catch (e) {
                console.error('❗❗❗ - [EVENT SUMMARY VIEW] Error parsing eventSetup JSON:', e);
              }
            } else {
              console.warn('⚠️⚠️⚠️ - [EVENT SUMMARY VIEW] No eventSetup data available for state restoration');
            }
            
            // 🟡🟡🟡 - [GLOBAL REF] Make calculator accessible globally
            try { window.__kloiCalc = calc; } catch(_e) {}
          } else {
            console.error('❗❗❗ - [EVENT SUMMARY VIEW] Calculator failed to initialize');
          }
        } else {
          console.warn('⚠️⚠️⚠️ - [EVENT SUMMARY VIEW] Missing data for calculator initialization');
        }
      }
    } catch (error) {
      console.error('❗❗❗ - [EVENT SUMMARY VIEW] Error initializing calculator:', error);
    }
    {{else}}
    console.log('🟡🟡🟡 - [EVENT SUMMARY VIEW] Calculator not shown - missing required data');
    {{/if}}

    const editButtons = document.querySelectorAll('.edit-btn');
    editButtons.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        const href = this.getAttribute('href');
        const step = this.getAttribute('data-step');
        console.log('🟡🟡🟡 - [EVENT SUMMARY VIEW] Edit click ->', step, href);
        // Summary has no form; navigate directly, pages restore from session
      });
    });

    const checkoutBtn = document.getElementById('checkoutBtn');
    if (checkoutBtn) {
      checkoutBtn.addEventListener('click', async function(e) {
        e.preventDefault(); // Prevent default navigation
        console.log('🟡🟡🟡 - [EVENT SUMMARY VIEW] Proceed to checkout clicked');
        
        // 🟡🟡🟡 - [CALCULATOR TOTALS] Save calculator totals to session before navigating to checkout
        // ⚠️⚠️⚠️ - [CALCULATOR TOTALS] This ensures checkout route has access to calculator totals
        try {
          const calc = window.__kloiCalc || (window.KloiCalculator && window.KloiCalculator.current);
          if (calc && typeof calc.getQuote === 'function' && typeof calc.getState === 'function') {
            const quote = calc.getQuote();
            const state = calc.getState();
            
            if (quote && quote.total > 0) {
              console.log('🟡🟡🟡 - [EVENT SUMMARY VIEW] Saving calculator totals before checkout:', quote.total);
              
              // 🟡🟡🟡 - [READ SESSION DATA] Get existing eventSetup from session (from server data)
              const summaryServerData = document.getElementById('summaryServerData');
              const eventSetupJson = summaryServerData?.dataset.eventSetup;
              let eventSetupData = null;
              
              if (eventSetupJson && eventSetupJson !== 'null') {
                try {
                  eventSetupData = JSON.parse(eventSetupJson);
                } catch (parseError) {
                  console.error('❗❗❗ - [EVENT SUMMARY VIEW] Error parsing eventSetup JSON:', parseError);
                }
              }
              
              // 🟡🟡🟡 - [BUILD PAYLOAD] Build event setup payload with calculator totals
              // Use existing eventSetup data and update/add calculator totals
              const payload = eventSetupData || {};
              
              // 🟡🟡🟡 - [CALCULATOR TOTALS] Add/update calculator totals from current quote
              payload.calculator = {
                guestCount: quote.guestCount || state?.guestCount || 0,
                numberOfDays: quote.numberOfDays || state?.numberOfDays || 1,
                totals: {
                  subtotal: quote.subtotal || 0,
                  total: quote.total || 0,
                  minimumOrderTotal: quote.minimumOrderTotal || 0
                },
                breakdown: quote.breakdown || [],
                minimumOrderBreakdown: quote.minimumOrderBreakdown || []
              };
              
              // 🟡🟡🟡 - [SAVE TO SESSION] Save calculator totals to session via API
              const response = await fetch('/api/session/event', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify(payload)
              });
              
              if (response.ok) {
                const result = await response.json();
                console.log('✅✅✅ - [EVENT SUMMARY VIEW] Calculator totals saved to session:', payload.calculator.totals.total);
                // Navigate to checkout after successful save
                window.location.href = '/checkout';
              } else {
                const errorText = await response.text();
                console.error('❗❗❗ - [EVENT SUMMARY VIEW] Failed to save calculator totals:', response.status, errorText);
                // Still navigate to checkout - it will handle missing totals
                window.location.href = '/checkout';
              }
            } else {
              console.warn('⚠️⚠️⚠️ - [EVENT SUMMARY VIEW] Calculator quote not available or total is 0, proceeding to checkout');
              window.location.href = '/checkout';
            }
          } else {
            console.warn('⚠️⚠️⚠️ - [EVENT SUMMARY VIEW] Calculator not available, proceeding to checkout');
            window.location.href = '/checkout';
          }
        } catch (error) {
          console.error('❗❗❗ - [EVENT SUMMARY VIEW] Error saving calculator totals:', error);
          // Still navigate to checkout - it will handle missing totals
          window.location.href = '/checkout';
        }
      });
    }
  });
</script>

{{! Event summary view }}
