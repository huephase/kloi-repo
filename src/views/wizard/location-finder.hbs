{{!-- src/views/wizard/location-finder.hbs Rendered for /location-finder on themed subdomains --}}
{{! Location finder view }}

<!-- Developer Note: Use {{theme}}, {{themeColor}}, and {{googleMapsApiKey}} from the route handler. -->
<!-- 2025-11-07T00:00:00Z 🟡🟡🟡 - [location-finder.hbs] Autocomplete input removed - location is now selected from delivery-locations page -->
<div class="kloi-location-finder">
  <div id="GOOGLE_CONTAINER" style="min-width:80%;min-height:300px;"></div>
  <div class="lf-location-controls">
  <button type="button" id="lf-detect-btn" class="lf-detect-btn pill-bt">Detect My Location</button>
  <div class="lf-infowindow-content" style="display: none;">
    <div class="location-field"><strong>City:</strong> <span id="lf-city">Not set</span></div>
    <div class="location-field"><strong>Country:</strong> <span id="lf-country">Not set</span></div>
    <div class="location-field"><strong>Latitude:</strong> <span id="lf-latitude"></span></div>
    <div class="location-field"><strong>Longitude:</strong> <span id="lf-longitude"></span></div>
  </div>
  <form id="location-details" method="POST" action="/api/session/location">
    <input type="hidden" id="lf-placeId" name="placeId" />
    <input type="hidden" id="lf-fullAddress" name="fullAddress" />
    <input type="hidden" id="lf-city-hidden" name="city" />
    <input type="hidden" id="lf-country-hidden" name="country" />
    <input type="hidden" id="lf-latitude-hidden" name="latitude" />
    <input type="hidden" id="lf-longitude-hidden" name="longitude" />
    <button type="submit" id="confirm-location" class="lf-confirm-btn" disabled>
      <span id="lf-confirm-label">KINDLY CHOOSE A LOCATION</span>
    </button>
    </div>
  </form>
  </div>
  <div id="lf-error-msg" class="lf-error-msg"></div>
  
  <!-- 2025-12-XXT00:00:00Z 🟡🟡🟡 - [location-finder.hbs] Boundary violation popup -->
  <div id="boundary-violation-popup" class="boundary-violation-popup" style="display: none;">
    <div class="boundary-violation-popup-content">
      <h3>Location Outside Selected Area</h3>
      <p>You've moved the marker outside your selected delivery area. Please stay within <strong id="popup-selected-area"></strong> to continue.</p>
      <div class="boundary-violation-popup-actions">
        <button type="button" id="boundary-popup-reselect-btn" class="boundary-popup-btn boundary-popup-btn-primary">Change My Area</button>
        <button type="button" id="boundary-popup-dismiss-btn" class="boundary-popup-btn boundary-popup-btn-secondary">OK</button>
      </div>
    </div>
  </div>
</div>
<!-- 2025-12-XXT00:00:00Z 🟡🟡🟡 - [location-finder.hbs] Event-driven architecture modules - load in dependency order -->
<script src="/public/global/js/map-events.js"></script>
<script src="/public/global/js/map-state.js"></script>
<script src="/public/global/js/map-polygon.js"></script>
<script src="/public/global/js/map-validation.js"></script>
<script src="/public/global/js/map-ui.js"></script>
<script src="/public/global/js/maps.js"></script>
<script>
  // 2025-11-07T00:00:00Z 🟡🟡🟡 - [location-finder.hbs] Initialize map with session location data
  window.addEventListener('DOMContentLoaded', function() {
    // 🟡🟡🟡 - [location-finder.hbs] Parse session location data from JSON string
    let sessionLocationData = null;
    try {
      sessionLocationData = {{{locationDataJson}}};
    } catch (err) {
      console.error('❗❗❗ - [location-finder.hbs] Failed to parse location data:', err);
    }
    window.initLocationFinderMap({
      apiKey: '{{googleMapsApiKey}}',
      mapId: '{{googleMapsMapId}}',
      containerId: 'GOOGLE_CONTAINER',
      detectBtnId: 'lf-detect-btn',
      formId: 'location-details',
      confirmBtnId: 'confirm-location',
      displayFields: {
        city: 'lf-city',
        country: 'lf-country',
        latitude: 'lf-latitude',
        longitude: 'lf-longitude'
      },
      hiddenFields: {
        placeId: 'lf-placeId',
        fullAddress: 'lf-fullAddress',
        city: 'lf-city-hidden',
        country: 'lf-country-hidden',
        latitude: 'lf-latitude-hidden',
        longitude: 'lf-longitude-hidden'
      },
      errorMsgId: 'lf-error-msg',
      initialLocationData: sessionLocationData,
      polygonCoordinateOrder: '{{mapPolygonOrder}}' // 2025-12-XXT00:00:00Z 🟡🟡🟡 - [location-finder.hbs] Pass MAP_POLYGON env variable to client
    });
  });
</script>